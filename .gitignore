# 墨舟仓库根忽略（app/ 内另有 .gitignore）
# 标定产物与模型缓存不入库
# 设计期产物与部署工作目录：不得入库
*.log
*.tsbuildinfo
*.patch
# .scratch 里仅 mozhou-mvp（契约/工单）与诊断报告是工程资产，保持可跟踪；
# 其余临时草稿不入库
.scratch/*
!.scratch/mozhou-mvp/
!.scratch/mozhou-diagnosis-20260822/
!.scratch/morning-report.md
# 深化工单与其执行记录是本轮工单 01–08 的规格依据，必须入库，
# 否则提交后规格依据消失、下一次改动无从判断验收标准
!.scratch/mozhou-deepening-20260928/
.worktrees/
.mimosa/
.next/
.zcode/
.mozhou_data/
apps/web/.mozhou_data/
dist/
dist-server/
target/
src-tauri/target/
# Tauri 生成的 ACL 能力清单与运行期自描述文件，每次构建/启动重新生成
src-tauri/gen/
desktop-runtime.json
archive-legacy/
release-artifacts/
figma-upload/
node_modules/
scripts/embedding-calib/.cache/
scripts/embedding-calib/fp32-model/

# 验收与审计过程产物：体积大（.dsh-audit 约 109M、模型旅程证据约 27M、
# 编译缓存约 8.7M）且每轮重新生成，不应进版本库。
# 需要的结论已在 .dsh-audit/launchfix/*.md 与工单执行记录里摘要。
.dsh-audit/
artifacts/
.tmp-vite-build/
# 模型旅程证据逐轮追加、含完整生成文本；已追踪的 R-fixes 等既有证据保留入库
evidence/*
!evidence/R-fixes/
# Windows 设备名误建的文件
nul

# agent 编队运行状态与一次性外部审查输出（2026-10-05 落账时划出）
.agent-teams/
review-result.json
# 导航验收脚本的一次性运行输出（scripts/release/navigation-acceptance.mjs 写 cwd）
navigation-acceptance-report.json

# archify 架构图交付物：精选证据（candidate.json / mozhou.*.json / mozhou.html）按既有
# 约定入库；每轮重新生成的渲染图（体积大）与评审前候选快照不入库。
# 判据与上面 .dsh-audit / evidence 同款：体积大且每轮重新生成。
.archify/**/visual-check/
.archify/**/mozhou.visual-check.*.png
.archify/**/*-backup.json

# 本地凭据与私钥：商业发行仓库禁止误提交
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
*.p12
*.pfx
