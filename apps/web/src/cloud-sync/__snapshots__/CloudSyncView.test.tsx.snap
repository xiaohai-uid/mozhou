            </div>
            <div>
              <div
                class="mono muted"
              >
                本地数据库体积
              </div>
              <b
                style="font-size: 15px;"
              >
                64
                 KB
              </b>
            </div>
            <div>
              <div
                class="mono muted"
              >
                未同步变动
              </div>
              <b
                style="font-size: 15px; color: var(--success);"
              >
                0
                 处（已全量落盘）
              </b>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section
      class="wb-section"
      data-testid="sync-backup-section"
    >
      <h2>
