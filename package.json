{
  "name": "mozhou",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "node scripts/check-install-env.mjs",
    "build": "tsc -b",
    "start": "node scripts/launcher.mjs",
    "build:release": "node scripts/build-release.mjs",
    "package:windows": "pnpm build && pnpm --filter @mozhou/web build && node scripts/release/windows/build.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "package": "node scripts/build-release.mjs",
    "lint": "eslint .",
    "test": "pnpm run test:packages && pnpm run test:web",
    "test:packages": "vitest run && vitest run --config vitest.bench.config.ts",
    "test:web": "pnpm --filter @mozhou/web test",
    "verify:real-model": "node scripts/verify-real-model-journey.mjs",
    "verify:journey": "node scripts/verify-mock-journey.mjs",
    "verify:desktop-key-guard": "node scripts/verify-desktop-key-guard.mjs",
    "verify:desktop-stop-result": "node scripts/verify-desktop-stop-result.mjs",
    "verify:desktop-instance-identity": "node scripts/verify-desktop-instance-identity.mjs",
    "graph:status": "node .gitnexus/run.cjs status",
    "graph:analyze": "node .gitnexus/run.cjs analyze",
    "graph:snapshot": "node scripts/export-code-graph.mjs",
    "audit:unreferenced": "node scripts/audit-unreferenced.mjs",
    "graph:check": "node .gitnexus/run.cjs check --cycles --json -r .",
    "test:real-model": "node scripts/run-real-model-tests.mjs",
    "gen:architecture": "node scripts/gen-architecture.mjs",
    "check:architecture": "node scripts/gen-architecture.mjs --check",
    "gen:adr-refs": "node scripts/gen-adr-refs.mjs",
    "check:glossary": "node scripts/verify-glossary.mjs",
    "check:gates": "node scripts/verify-gates-contract.mjs",
    "gen:term-map": "node scripts/gen-term-map.mjs",
    "check:term-map": "node scripts/gen-term-map.mjs --self-test && node scripts/gen-term-map.mjs --check",
    "check:readmes": "node scripts/verify-package-readmes.mjs",
    "duplication": "npx --yes jscpd@3.5.10 --config .jscpd.json .",
    "coverage:check": "node scripts/report-coverage-status.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.0.4"
  },
  "pnpm": {
    "overrides": {
      "tar": "7.5.22",
      "js-yaml": "4.3.2",
      "fast-uri": "3.1.7",
      "brace-expansion@^1.0.0": "1.1.20",
      "brace-expansion@^5.0.0": "5.0.11",
      "source-map-js": "1.2.2"
    },
    "patchedDependencies": {
      "fastembed@2.1.0": "patches/fastembed@2.1.0.patch"
    }
  }
}
