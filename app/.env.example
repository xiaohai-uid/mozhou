# MoZhou local environment template. Copy to app/.env and fill real values.
# NEVER commit app/.env.

# PostgreSQL (local dev)
DATABASE_URL=postgres://mozhou:mozhou_dev@localhost:5433/mozhou

# JWT signing key (local dev default; production must be replaced)
AUTH_SECRET=change-me

# one-api gateway
ONEAPI_BASE_URL=http://localhost:3000
# Create a token inside one-api and paste it here (local secret)
ONEAPI_TOKEN=<ONEAPI_TOKEN>
