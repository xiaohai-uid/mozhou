#!/bin/sh
# 墨舟仓库的提交钩子（仓库内、随代码版本化）。
#
# 激活方式：node scripts/install-hooks.mjs（它把仓库级 core.hooksPath 指向本目录）。
#
# 为什么不放在 .git/hooks/pre-commit：本机全局 gitconfig 设了
# `core.hooksPath = C:/Users/a1691/.zcode/git-hooks`，Git 会**完全忽略** `.git/hooks/`。
# 2026-10-10 实测：装在 `.git/hooks/` 的钩子在 `git commit` 时根本没有执行（探针提交
# 顺利落盘）。所以本仓用仓库内的 `.githooks/`，并把机器级钩子**链式调用**回来——
# 两边的检查都不丢（机器级那套扫凭据字面量，本仓这套查仓库自己的门）。
#
# 只跑不需要构建、不需要联网、秒级的检查。刻意不跑 pnpm lint（类型感知 lint 依赖
# packages/*/dist 的 .d.ts，未构建的树上会产生千级误报，见 ci.yml 中「Static lint gate」
# 上方注释）与 pnpm test（太慢）。
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

# ── 1) 机器级钩子先跑（不归本仓管，链回来即可）────────────────────────────
global_dir=$(git config --global --get core.hooksPath 2>/dev/null || true)
if [ -n "${global_dir:-}" ] && [ -f "$global_dir/pre-commit" ]; then
  # 防自递归：全局目录就是本仓 .githooks 时跳过
  if [ "$global_dir" != "$(git rev-parse --show-toplevel)/.githooks" ]; then
    sh "$global_dir/pre-commit" || exit $?
  fi
fi

# ── 2) 本仓快速门 ────────────────────────────────────────────────────────
echo "[pre-commit] 快速检查：术语 / 门清单（含在 CI 列一致性）/ 包 README / 静态导入环"
node scripts/verify-glossary.mjs || exit 1
node scripts/verify-gates-contract.mjs || exit 1
node scripts/check-gates-ci-column.mjs || exit 1
node scripts/verify-package-readmes.mjs || exit 1
node scripts/check-import-cycles.mjs || exit 1

# ── 3) 只报不拦的两项 ────────────────────────────────────────────────────
# 生成物新鲜度：把生成物与**整个工作区**比对，别人未提交的改动也会让它们不一致，
# 阻断会替别人的在制工作背锅；已提交状态由 CI 的 Doc gates 判定。
# 文档裸数字：阈值未定，先让漂移可见（脚本本身 exit 0）。
echo "[pre-commit] 生成物新鲜度（仅告警，不阻断）"
node scripts/gen-architecture.mjs --check \
  || echo "[pre-commit] 提示：docs/architecture.md 与当前工作区不一致。要刷新请跑 node scripts/gen-architecture.mjs"
node scripts/gen-term-map.mjs --check \
  || echo "[pre-commit] 提示：docs/term-map.md 与当前工作区不一致。要刷新请跑 node scripts/gen-term-map.mjs"
node scripts/check-doc-numbers.mjs

echo "[pre-commit] 通过"
