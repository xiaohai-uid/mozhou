  %% 启动与编排时序
  innoSetup -- "安装/升级/卸载前调用<br/>MoZhou.exe --stop<br/>[HEAD:90b45a1]" --> csLauncher
  csLauncher -- "1. 声明并获取排他所有权" --> winMutex
  csLauncher -- "2. 创建事件句柄" --> winStopEvent
  csLauncher -- "3. 挂载系统托盘" --> winTray
  csLauncher -- "4. 派生确定性端口 (43000-43999)<br/>并 spawn runtime/node.exe<br/>[HEAD:90b45a1]" --> desktopServerMjs
  nodeLauncher -- "检查构建产物缺失则 build<br/>spawn node productionServer.js<br/>[HEAD:90b45a1]" --> prodServer

  desktopServerMjs -- "读取/生成 48字节 installation.key<br/>动态 import productionServer.js<br/>[HEAD:90b45a1]" --> prodServer
  prodServer -- "获取目录独占锁<br/>(检查 PID 存活)<br/>[HEAD:90b45a1]" --> instanceFileLock

  %% 运行时内部连线
  prodServer --> bookQueue
  prodServer --> reconcileManager
  prodServer --> sqliteEngine
  prodServer --> onnxEngine
  reconcileManager --> fsWatchThreads

  %% 通信通道
  csLauncher -- "私有 stdin 管道发送 'shutdown\\n'<br/>[HEAD:90b45a1]" --> desktopServerMjs
