  prodServer -- "HTTP 监听 127.0.0.1:PORT<br/>(静态资源 + API 路由)<br/>[HEAD:90b45a1]" --> browser
  prodServer -. "HTTP 监听 (若配置 devUrl)<br/>[HEAD:90b45a1]" .-> tauriWebView
  browser --> clientDeAi

  %% 停机与释放
  prodServer -- "SIGTERM/exit 触发<br/>releaseResources()<br/>关闭连接/排空在途/释放文件锁<br/>[HEAD:90b45a1]" --> instanceFileLock
